# Copy this file to `.env` (same folder) and fill in your own values. `.env` is git-ignored; this example is safe to commit.
# Every setting is optional in development; the defaults are in backend/app/core/config.py.

# Database. SQLite is the development default; use PostgreSQL in production.
# LDM_DATABASE_URL=sqlite:///./league_draft_manager.db
# LDM_DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# Secret used to sign login tokens. CHANGE THIS outside development: at least 32 random characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
LDM_SECRET_KEY=change-me

# Browser origins allowed to call the API when the frontend is served from a different address (JSON list).
# LDM_CORS_ORIGINS=["http://localhost:5173"]

# Riot account import (optional). Get a personal key at https://developer.riotgames.com
# The key is secret: never commit it, never put it in frontend code.
LDM_RIOT_API_KEY=
